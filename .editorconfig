root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Adopt ktlint's official code style as the single source of truth.
# Max line length aligns with the Kotlin ecosystem default.
ktlint_code_style = ktlint_official
max_line_length = 140

# Repo-specific deviations (justified):
# Wildcard imports exist in long-standing code and are readable in test DSLs.
ktlint_standard_no-wildcard-imports = disabled
# KDoc section headers stacked back-to-back are idiomatic; the rule wants noise
# blank lines between every doc-comment pair.
ktlint_standard_no-consecutive-comments = disabled
# Inline argument comments (e.g. `foo(x, /* reason */ y)`) are a documentation
# pattern used heavily in CardProtoBuilder / BundleBuilder; the rule would
# require splitting them across lines, hurting local readability.
ktlint_standard_discouraged-comment-location = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
