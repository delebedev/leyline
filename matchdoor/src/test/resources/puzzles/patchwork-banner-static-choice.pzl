# Design Narrative
# Mechanic: Patchwork Banner's static subtype choice prompt and chosen-type buff.
# Forcing: Patchwork Banner is the only hand card; choosing Goblin makes the existing Raging Goblin visibly larger.
# AI behavior: Opponent has no board or hand decisions; the scripted player casts the artifact and answers the static prompt.
# Failure modes:
#   WIN = Patchwork Banner resolved; the acceptance suite checks Raging Goblin's buffed stats.
#   LOSE = the artifact could not be cast or did not resolve within the turn budget.
#   TIMEOUT = the static SelectN prompt was not emitted or the response did not unblock resolution.
# Card roles:
#   Patchwork Banner - source of the subtype static choice and chosen-type anthem.
#   Raging Goblin - Goblin creature whose buff proves the chosen type was stored and applied.
#   Mountains - pay the three generic mana cost.
# Protocol path: Cast action -> priority pass -> SelectNReq static subtype -> SelectNResp id 34 -> ChoiceResult and persistent LinkInfo.

[metadata]
Name:Patchwork Banner Static Choice
Goal:Play the Specified Permanent
Turns:3
Difficulty:Easy
Description:Cast Patchwork Banner, choose Goblin, and verify the chosen-type buff applies.
Targets:Patchwork Banner

[state]
ActivePlayer=Human
ActivePhase=Main1
HumanLife=20
AILife=20

humanbattlefield=Mountain;Mountain;Mountain;Raging Goblin
humanhand=Patchwork Banner
humanlibrary=Mountain
ailibrary=Forest
